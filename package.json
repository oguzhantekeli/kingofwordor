{
  "name": "kingofwordor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src tools",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build:dict": "node tools/build-dict.mjs",
    "build:assets": "node tools/build-assets.mjs",
    "verify": "npm run lint && npm run test && npm run build && npm audit --omit=dev --audit-level=low",
    "report": "vitest run --reporter=html",
    "serve:report": "vite preview --outDir .vitest --port 5174 --host 0.0.0.0",
    "build:sprites": "node tools/build-sprites.mjs",
    "build:music": "node tools/build-music.mjs",
    "build:all": "npm run build:dict && npm run build:assets && npm run build:sprites && npm run build:music && npm run build:fonts",
    "build:fonts": "node tools/build-fonts.mjs",
    "sync:android": "npx cap sync android && node tools/android-config.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.1.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@capgo/capacitor-social-login": "8.5.11",
    "@capgo/native-purchases": "8.8.1",
    "@supabase/supabase-js": "2.117.2",
    "i18next": "26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@electric-sql/pglite": "^0.5.8",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "^5.0.3",
    "ffmpeg-static": "5.3.0",
    "jsdom": "30.1.1",
    "oxlint": "1.86.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
