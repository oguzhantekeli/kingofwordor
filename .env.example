# Copy to .env and fill in. .env is gitignored; this file is not.
# Anything prefixed VITE_ is inlined into the client bundle and ships in the APK.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key - public by design, protected by RLS>

# Native Google Sign-In. Both are public identifiers, not secrets.
VITE_GOOGLE_WEB_CLIENT_ID=<web client id>.apps.googleusercontent.com
